POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

# YNAB credentials. The app boots without these; /sync returns 503 until set.
YNAB_TOKEN=
YNAB_BUDGET_ID=

# Anthropic credentials. The app boots without these; /ask returns 503 until set.
ANTHROPIC_API_KEY=

# APP_VERSION is set by the deploy workflow per deploy (commit SHA).
# Uncomment and set only if bringing the stack up manually on the VM.
# APP_VERSION=manual
