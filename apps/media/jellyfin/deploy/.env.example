# Copy to .env on the media VM next to the compose file (never commit the real .env).

# User/group that owns /config, /cache, and /data on the media VM. Run `id` as the
# deploy user and use its uid:gid so Jellyfin writes with the right permissions.
PUID=1000
PGID=1000

TZ=America/Toronto

# Private Internet Access login for the WireGuard VPN gateway (qBittorrent runs behind it).
# Set the real values in .env on the VM; never commit them. VPN_LOC is optional (PIA region
# id in thrnz format, e.g. ca_toronto / ca_montreal; must support port forwarding).
OPENVPN_USER=
OPENVPN_PASSWORD=
# VPN_LOC=ca_toronto

# Phase 3 only.
# Render group id for QuickSync passthrough (on the VM: `getent group render`).
# RENDER_GID=989
