# Copy to .env on the media VM next to the compose file (never commit the real .env).

# User/group that owns /config, /cache, and /data on the media VM. Run `id` as the
# deploy user and use its uid:gid so Jellyfin writes with the right permissions.
PUID=1000
PGID=1000

TZ=America/Toronto

# Private Internet Access login for the gluetun VPN gateway (qBittorrent runs behind it).
# Set the real values in .env on the VM; never commit them. VPN_REGION is optional.
OPENVPN_USER=
OPENVPN_PASSWORD=
# VPN_REGION=CA Toronto

# Apex domain Caddy serves the media hosts under: jellyfin.<domain>, jellyseerr.<domain>.
MEDIA_DOMAIN=

# Cloudflare API token (Zone:DNS:Edit on your domain) for Caddy's Let's Encrypt DNS-01 certs.
CLOUDFLARE_API_TOKEN=

# Phase 3 only.
# Render group id for QuickSync passthrough (on the VM: `getent group render`).
# RENDER_GID=989
# Public URL once the Caddy HTTPS path exists.
# JELLYFIN_PublishedServerUrl=https://jellyfin.<your-domain>
